{
  "name": "transitops",
  "version": "0.1.0",
  "private": true,
  "description": "Smart Transport Operations Platform foundation.",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm --workspace backend run dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "start:backend": "npm --workspace backend run start",
    "preview:frontend": "npm --workspace frontend run preview",
    "seed:demo": "npm --workspace backend run seed:demo",
    "lint": "npm --workspaces run lint",
    "build": "npm --workspace backend run build && npm --prefix frontend run build",
    "test": "npm --workspaces run test"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
